{
  "name": "tickets",
  "label": "Tickets",
  "accesscat": "tickets",
  "content": [
    {
      "type": "dataset",
      "content": [
        {
          "type": "hsection",
          "content": [
            {
              "grow": 0,
              "shrink": 0,
              "type": "vsection",
              "content": [
                {
                  "grow": 0,
                  "shrink": 0,
                  "type": "hsection",
                  "content": [
                    {
                      "action": "create",
                      "label": "New",
                      "type": "button"
                    },
                    {
                      "type": "search"
                    }
                  ]
                },
                {
                  "type": "list4",
                  "meta1attribute": "code",
                  "meta2attribute": "status.label",
                  "mainattribute": "label",
                  "subattribute": "requestdate"
                }
              ]
            },
            {
              "type": "hseparator"
            },
            {
              "type": "vsection",
              "content": [
                {
                  "grow": 0,
                  "shrink": 0,
                  "type": "hsection",
                  "content": [
                    {
                      "icon": "draft",
                      "label": "Code",
                      "attribute": "code",
                      "type": "input",
                      "size": 8
                    },
                    {
                      "type": "input",
                      "attribute": "label",
                      "label": "Label",
                      "size": 30
                    },
                    {
                      "type": "relatedinput",
                      "attribute": "status",
                      "displayattribute": "label",
                      "size": 10,
                      "icon": "device_hub"
                    },
                    {
                      "type": "spacer"
                    },
                    {
                      "type": "actiongroup",
                      "actions": [
                        {
                          "action": "execute",
                          "target": "submit",
                          "label": "Submit",
                          "show": "object != null && object.get('status') == 'draft'"
                        },
                        {
                          "action": "execute",
                          "target": "resubmit",
                          "label": "Resubmit",
                          "show": "object != null && object.get('status') == 'clarification'"
                        },
                        {
                          "action": "execute",
                          "target": "start",
                          "label": "Start Work",
                          "show": "object != null && object.get('status') == 'submitted'"
                        },
                        {
                          "action": "execute",
                          "target": "clarify",
                          "label": "Return for Clarification",
                          "show": "object != null && (object.get('status') == 'submitted' || object.get('status') == 'inprogress')"
                        },
                        {
                          "action": "execute",
                          "target": "archive",
                          "label": "Archive",
                          "confirm": "Archive this ticket?",
                          "show": "object != null && object.get('status') == 'inprogress'"
                        },
                        {
                          "action": "delete",
                          "label": "Delete",
                          "show": "object != null && object.get('status') != 'archived'"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "hsection",
                  "grow": 1,
                  "content": [
                    {
                      "type": "richtext",
                      "attribute": "details",
                      "size": 50,
                      "rows": 20
                    },
                    {
                      "type": "hsection",
                      "grow": 1,
                      "content": [
                        {
                          "type": "dataset",
                          "object": "ticketLog",
                          "name": "ticketLogs",
                          "master": {
                            "relationship": {
                              "ticketUid": "uid"
                            }
                          },
                          "basesort": {
                            "0": {
                              "attribute": "createdDate",
                              "dir": -1
                            }
                          },
                          "content": [
                            {
                              "type": "log",
                              "userattribute": "createdBy",
                              "dateattribute": "createdDate",
                              "entryattribute": "entry",
                              "categoryattribute": "category",
                              "size": 20
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "hsection",
                  "grow": 0,
                  "shrink": 0,
                  "content": [
                    {
                      "type": "input",
                      "attribute": "requestor",
                      "label": "Requestor",
                      "icon": "person",
                      "size": 15
                    },
                    {
                      "type": "relatedinput",
                      "attribute": "assignee",
                      "displayattribute": "label",
                      "label": "Assignee",
                      "icon": "person",
                      "size": 15
                    },
                    {
                      "type": "relatedinput",
                      "attribute": "ticketClassification",
                      "displayattribute": "label",
                      "label": "Ticket Classification",
                      "icon": "category",
                      "size": 15
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "object": "ticket"
    }
  ]
}
