{
	"name":"tickets",
	"label":"Tickets",
	"accesscat":"tickets",
	"content":[
		{
			"type":"dataset",
			"content":[
				{
					"type":"hsection",
					"content":[
						{
							"grow":0,
							"shrink":0,
							"type":"vsection",
							"content":[
								{
									"grow":0,
									"shrink":0,
									"type":"hsection",
									"content":[
										{
											"action":"create",
											"label":"New",
											"type":"button"
										},
										{
											"type":"search"
										}
									]
								},
								{
									"type":"list4",
									"meta1attribute":"code",
									"meta2attribute":"status.label",
									"mainattribute":"label",
									"subattribute":"requestdate"
									
								}
							]
						},
						{
							"type":"hseparator"
						},
						{
							"type":"vsection",
							"content":[
								{
									"grow":0,
									"shrink":0,
									"type":"hsection",
									"content":[
										{
											"icon":"draft",
											"label":"Code",
											"attribute":"code",
											"type":"input",
											"size":8
										},
										{
											"type":"input",
											"attribute":"label",
											"label":"Label",
											"size":30
										},
										{
											"type":"relatedinput",
											"attribute":"status",
											"displayattribute":"label",
											"size":10,
											"icon":"device_hub"
										},
										{
											"type":"spacer"
										},
										{
											"type":"actiongroup",
											"actions":[
												{
													"action":"delete",
													"label":"Delete",
													"show":"object != null"
												}
											]
										}
									]
								},
								{
									"type":"hsection",
									"grow":1,
									"content":[
										{
											"type":"richtext",
											"attribute":"details",
											"size":50,
											"rows":20
										}										
									]
								},
								{
									"type":"hsection",
									"grow":0,
									"shrink":0,
									"content":[
										{
											"type":"input",
											"attribute":"requestor",
											"label":"Requestor",
											"icon":"person",
											"size":15
										}										
									]
								}								
							]
						}
					]
				}
			],
			"object":"ticket"
		}
	]
}