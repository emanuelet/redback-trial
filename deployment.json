{
	"network":"{{firebus}}",
	"password":"trialpassw",
	"servicethreads":10,
	"streamthreads":10,
	"messagethreads":10,
	"discoveryagents":[
	],
	"services": [
		{
			"class":"io.firebus.adapters.http.HttpGateway",
			"name":"http",
			"priority":1,
			"config": {
				"port":"{{port}}",
				"path":"/",
				"publichost":"{{publichost}}",
				"rootforward":"/rbui",
				"security":[
					{
						"name":"sec1",
						"type":"jwtcookie",
						"accesstokencookie":"rbtoken",
						"refreshtokencookie":"rbrefresh",
						"fbmetaname":"token",					
						"timeout":604800000
					}					
				],
				"inbound":[
					{
						"service":"rbui",
						"path":"/rbui/*",
						"method":"get",
						"security":"sec1"
					},
					{
						"service":"rbos",
						"path":"/rbos/*",
						"method":"post",
						"security":"sec1"
					},
					{
						"service":"rbfs",
						"path":"/rbfs/*",
						"method":"post",
						"contenttype":"application/json",
						"security":"sec1"
					},
					{
						"stream":"rbfs",
						"path":"/rbfs/*",
						"type":"filestream",
						"security":"sec1"
					},					
					{
						"service":"rbup",
						"path":"/rbup/*",
						"method":"post",
						"security":"sec1"
					}				
				],
				"websockets":[
					{
						"service":"rbcs",
						"path":"/rbcs/*",
						"type":"stream",
						"security":"sec1"
					}
				],
				"idms":[
					{
						"uri":"io.redback",						
						"path":"/auth/rb/*",
						"type":"oauth2code",
						"loginurl":"{{idmurl}}/auth",
						"tokenurl":"{{idmurl}}/token",
						"keysurl":"{{idmurl}}/keys",
						"clientid":"{{webclientid}}",
						"clientsecret":"{{webclientsecret}}",
						"scope":"openid email",
						"security":"sec1",
						"label":"SkyPlan",
						"icon":"data:image/png;base64,"
					}
				],
				"outbound":[
					{
						"service":"rbgw"
					}
				]					
			}
		},
		{
			"class":"io.redback.services.impl.RedbackUIServer",
			"name":"rbui",
			"priority":3,
			"concurrent":20,
			"config":{
				"configservice":"rbcf",
				"dataservice":"db",
				"accessmanagementservice":"rbam",
				"useclientforapi":true,
				"servicemap":{
					"ui":"rbui",
					"object":"rbos",
					"file":"rbfs",
					"userpreference":"rbup",
					"client":"rbcs"			
				},
				"globalvariables":{
					"googlekey":null
				}
			}
		},					
		{
			"class":"io.redback.services.impl.RedbackObjectServer",
			"concurrent":20,
			"name":"rbos",
			"priority":2,
			"config":{
				"configservice":"rbcf",
				"dataservice":"db",
				"idgeneratorservice":"rbid",
				"accessmanagementservice":"rbam",
				"fileservice":"rbfs",
				"objectupdatechannel":"rbou"
			}
		},	
		{
			"class":"io.redback.services.impl.RedbackFileServer",
			"name":"rbfs",
			"priority":2,
			"config":{
				"dataservice":"db",
				"accessmanagementservice":"rbam",
				"idgeneratorservice":"rbid",
				"idname":"guid",
				"defaultstreamadapter":"fstream",
				"enablestream":true,
				"filecollection":{
					"name":"file",
					"map":{
						"fileuid":"_id",
						"filename":"filename",
						"mime":"mime",
						"username":"username",
						"date":"date",
						"hash":"hash"
					}
				},
				"linkcollection":{
					"name":"attachment",
					"map":{
						"linkid":"_id",
						"fileuid":"fileuid",
						"object":"object",
						"objectuid":"objectuid"
					}
				}					
			}
		},		
		{
			"class":"io.redback.services.impl.RedbackUserPreferenceServer",
			"name":"rbup",
			"priority":3,
			"config":{
				"dataservice":"db",
				"accessmanagementservice":"rbam",
				"collection":{
					"name":"rbup_entry",
					"map":{
						"username":"username",
						"role":"role",
						"domain":"domain",
						"value":"value"
					}
				}					
			}
		},				
		{
			"class":"io.redback.services.impl.RedbackClientServer",
			"name":"rbcs",
			"priority":3,
			"concurrent":60,
			"config":{
				"accessmanagementservice":"rbam",
				"fileservice":"rbfs",
				"dataservice":"db",
				"objectupdatechannel":"rbou",
				"chatchannel":"rbcm",
				"servicemap":{
					"rbos":"rbos",
					"rbfs":"rbfs",
					"rbup":"rbup"
				},
				"usercollection":{
					"name":"user"
				},
				"devicecollection":{
					"name":"device"
				}
			}
		},			
		{
			"class":"io.redback.services.impl.RedbackAccessManager",
			"name":"rbam",
			"priority":1,
			"concurrent":60,
			"config":{
				"configservice":"rbcf",
				"dataservice":"db",
				"outboundservice":"rbgw",
				"idm":{
					"userprofileurl":"{{idmurl}}/userprofile",
					"tokenurl":"{{idmurl}}/token",
					"clientid":"{{idmclientid}}",
					"clientsecret":"{{idmclientsecret}}"
				},
				"jwtvalidator":{
					"io.redback":{
						"sharedsecret":"{{jwtsecret}}",
						"keysurl":"{{idmurl}}/keys"
					}
				},
				"requestlog":false
			}
		},
		{
			"class":"io.redback.services.impl.RedbackIDGenerator",
			"name":"rbid",
			"priority":1,
			"config":{
				"configservice":"rbcf",
				"dataservice":"db",
				"requestlog": false
			}
		},	
		{
			"class":"io.redback.services.impl.RedbackInitializer",
			"name":"init",
			"priority":4,
			"config":{
				"dataservice":"db",
			 	"objectservice":"rbos",
				"accessmanagementservice":"rbam"
			}
		},				
		{
			"class":"io.redback.services.impl.RedbackConfigServer",
			"name":"rbcf",
			"priority":1,
			"config":{
				"devpath":"{{devpath}}",
				"dataservice":"db",
				"requestlog":false		
			}
		},		
		{
			"class":"io.firebus.adapters.FileStreamAdapter",
			"name":"fstream",
			"priority":2,
			"config":{
				"path":"."
			}
		},		
		{
			"class":"io.firebus.adapters.MongoDBAdapter",
			"name":"db",
			"priority":1,
			"concurrent":20,
			"config": {
				"connectionstring":"{{mongoconnection}}",
				"database":"{{mongodbname}}"
			}
		}	
	],
	"logging":{
		"level":"{{loglevel}}",
		"format":"{{logformat}}"
	}
}